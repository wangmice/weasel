# Customize your build environment and save the modified copy to env.ps1

$env:DEVTOOLS_PATH = 'C:\Program Files\Git\bin;C:\Program Files\Git\cmd;'

# Current working directory
# $env:WEASEL_ROOT = (Get-Location).Path
$env:WEASEL_ROOT = $PSScriptRoot
# REQUIRED: path to Boost source directory
$env:BOOST_ROOT = Join-Path $env:WEASEL_ROOT 'deps\boost_1_92_0'

# OPTIONAL: architecture, Visual Studio version and platform toolset
# $env:ARCH = 'Win32'

$env:BJAM_TOOLSET = 'msvc-14.3'
$env:CMAKE_GENERATOR = 'Visual Studio 17 2022'
$env:PLATFORM_TOOLSET = 'v143'

# OPTIONAL: path to additional build tools
# $env:DEVTOOLS_PATH = "$env:ProgramFiles\Git\cmd;$env:ProgramFiles\Git\usr\bin;$env:ProgramFiles\CMake\bin;"
